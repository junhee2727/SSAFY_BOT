{
  "name": "ssafy-mattermost-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Mattermost assistant for tasks and newsletter summaries",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "config:check": "node --env-file-if-exists=.env src/index.ts --check-config",
    "mattermost:check": "node --env-file-if-exists=.env src/index.ts --check-mattermost",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
