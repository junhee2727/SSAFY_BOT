# Required for core startup. Do not commit real credentials.
MATTERMOST_URL=
MATTERMOST_LOGIN_ID=
# Quote passwords containing # or leading/trailing spaces, e.g. "example#value".
MATTERMOST_PASSWORD=
# Optional: current 6-digit code if the server requires two-factor authentication.
MATTERMOST_MFA_TOKEN=

# Required only when newsletter.enabled is true.
NAVER_EMAIL=
NAVER_APP_PASSWORD=

# Required only when gms.enabled is true.
GMS_KEY=

# Optional: relative to the directory where the command is run.
BOT_CONFIG_PATH=config/settings.json
